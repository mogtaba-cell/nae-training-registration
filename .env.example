# Server-only. Never add these to public files or share them in chat.
JOTFORM_API_KEY=replace_with_private_jotform_key
JOTFORM_FORM_ID=262592775577071
JOTFORM_API_BASE=https://api.jotform.com

# New in v2: durable request storage and one-submission-per-school and per-school/session uniqueness.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_secret_key
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported, but prefer a new secret key.

# Protects the sync endpoint. Generate locally with the command in README.
CRON_SECRET=replace_with_random_32_byte_secret

# Optional school access-code gate; enable before distributing to schools.
# Generate one secret, then run: node --env-file=.env.local scripts/access-codes.js
# No coordinator emails or identity numbers are used as passwords.
SCHOOL_ACCESS_SECRET=

# Local interface preview only; NEVER enable on Vercel.
# This never accepts real submissions and displays a preview notice.
LOCAL_PREVIEW_ONLY=false
